<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <title><%= typeof title !== 'undefined' ? title : 'Floral Design' %></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <link href="/css/styles.css" rel="stylesheet" type="text/css" />
  </head>
  <body>
    <div id="container">
      <div id="topLine"></div>
      <div id="logoPan">
        <img
          src="/images/logo.gif"
          width="192"
          height="92"
          alt="Company logo"
          id="logo"
        />
        <img
          src="/images/slogan.gif"
          width="297"
          height="46"
          alt="Company slogan"
          id="slogan"
        />
      </div>
      <div id="menuPan">
        <ul class="menu">
          <li class="btn_1"><a href="#">Home</a></li>
          <li class="line"></li>
          <li class="btn_2"><a href="#">About Us</a></li>
          <li class="line"></li>
          <li class="btn_3"><a href="#">Bouquets</a></li>
          <li class="line"></li>
          <li class="btn_4"><a href="#">Specials</a></li>
          <li class="line"></li>
          <li class="btn_5"><a href="#">Contacts</a></li>
        </ul>
      </div>
      <div id="header">
        <img
          src="/images/slogan2.gif"
          width="192"
          height="70"
          alt=""
          id="slogan2"
        />
      </div>
      <div id="content">
        <div id="leftPan">
          <div id="welcome">
            <h2></h2>
            <img
              src="/images/img_welcome.jpg"
              width="172"
              height="56"
              alt="Welcome"
            />
            <p class="headline">
              Welcome to Floral Design. We create handcrafted bouquets and
              floral arrangements for every occasion.
            </p>
            <p>
              Our florists use only the freshest flowers to design pieces for
              weddings, events, and everyday gifting. Browse our featured
              collections or contact us for a custom order.
            </p>
          </div>
          <div id="aboutShop">
            <h2>About Our Shop</h2>
            <p>
              Flower Corner embraces an elegant, gentle, and modern style.
              Customers can choose from ready-made designs or request custom
              arrangements based on color, flower type, and budget.
            </p>
            <p>
              We provide floral decor for small events, corporate gifting, and
              personalized bouquets for special occasions.
            </p>
          </div>
          <div id="services">
            <h2>Featured Services</h2>
            <div class="service-grid">
              <div class="service-card">
                <h3>2-Hour Delivery</h3>
                <p>Fast local delivery to meet urgent orders right on time.</p>
              </div>
              <div class="service-card">
                <h3>Custom Designs</h3>
                <p>
                  Choose flower colors, bouquet styles, and cards for each
                  occasion.
                </p>
              </div>
              <div class="service-card">
                <h3>Fresh Flowers Daily</h3>
                <p>
                  We select fresh blooms and keep them protected before
                  delivery.
                </p>
              </div>
            </div>
          </div>
        </div>
        <div id="rightPan">
          <div id="contactForm">
            <h2>Order Flowers</h2>
            <input type="text" placeholder="Full name" />
            <input type="text" placeholder="Phone number" />
            <textarea placeholder="Request details"></textarea>
            <button>Send request</button>
          </div>
          <div id="featured">
            <h2></h2>
            <p class="headline">
              Discover our featured arrangements and seasonal specials. Fresh
              flowers, beautiful designs, delivered with care.
            </p>
            <div class="featItem" id="i01">
              <img src="/images/img_prod.jpg" width="116" height="125" alt="" />
              <p>
                <span class="headline2">Elegant Arrangements</span><br />
                <a href="#">Handcrafted Bouquets</a><br />
                Perfect for weddings, anniversaries, and special events.
              </p>
            </div>
            <div class="featItem" id="i02">
              <img
                src="/images/img_prod-13.jpg"
                width="116"
                height="125"
                alt=""
              />
              <p>
                <span class="headline2">Bright & Fresh</span><br />
                <a href="#">Seasonal Picks</a><br />
                Fresh, vibrant selections arranged by our expert florists.
              </p>
            </div>
            <div class="featItem" id="i03">
              <img
                src="/images/img_prod-14.jpg"
                width="116"
                height="125"
                alt=""
              />
              <p>
                <span class="headline2">Classic Designs</span><br />
                <a href="#">Timeless Bouquets</a><br />
                Traditional arrangements with a modern touch.
              </p>
            </div>
            <div class="clear"></div>
          </div>
        </div>
        <div class="clear" id="end"></div>
      </div>
    </div>
    <div id="footer">
      <p>
        <a href="#">HOME</a> | <a href="#">ABOUT</a> |
        <a href="#">BOUQUETS</a> | <a href="#">SPECIALS</a> |
        <a href="#">NEWS</a> | <a href="#">CONTACTS</a><br />
        Copyright &copy; Your Company Name | Design by
        <a href="http://freshtemplates.com/">Website Templates</a>
      </p>
    </div>
    <div align="center">
      This template downloaded from
      <a href="http://all-free-download.com/free-website-templates/"
        >free website templates</a
      >
    </div>
  </body>
</html>
